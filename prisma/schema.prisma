// ZPROO GO — PostgreSQL schema
//
// Conventions
// - Tables and columns are snake_case in the database (@@map / @map), camelCase in code.
// - Primary keys are cuid strings (non-enumerable).
// - Money is stored as integer minor units (paise) — never floats.
// - `deleted_at` marks soft-deleted rows; queries must filter on it.
//
// Phase 1 contains the identity and platform models. Each later phase adds its domain
// models through a new migration (see docs/DATABASE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum RoleName {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
  OPERATOR
  DRIVER
  HOTEL_PARTNER
  TRAVEL_PARTNER
  CORPORATE_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  CONTACT_VERIFICATION
}

enum OtpChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum ServiceType {
  FLIGHT
  BUS
  TRAIN
  HOTEL
  CAB
  BIKE
  HOLIDAY
  PARCEL
  CORPORATE
}

/// Lifecycle; legal moves are defined once in @zproo/utils (BOOKING_TRANSITIONS).
enum BookingStatus {
  DRAFT
  HELD
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  /// Captured but no ticket may be issued (hold expired / supplier failed): refund owed.
  REFUND_DUE
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ────────────────────────────── Identity ─────────────────────────────

model User {
  id              String     @id @default(cuid())
  /// E.164, e.g. +919876543210
  phone           String?    @unique
  /// Stored lower-cased.
  email           String?    @unique
  /// argon2id hash; null for OTP/social-only accounts.
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles          UserRole[]         @relation("UserRoles")
  rolesAssigned  UserRole[]         @relation("RoleAssigner")
  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  identities     AuthIdentity[]
  addresses      Address[]
  auditLogs      AuditLog[]
  settingsEdited SystemSetting[]
  bookings       Booking[]
  payments       Payment[]
  idempotency    IdempotencyKey[]
  redemptions    CouponRedemption[]
  travellers     SavedTraveller[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  /// System roles are created by the seed and cannot be deleted.
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  /// `resource:action[:scope]`, e.g. `booking:read:any`
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Opaque refresh tokens, stored as SHA-256 hashes. Rotated on every use; reuse of a
/// rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @unique @map("replaced_by_id")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One-time passwords. Only a hash of the code is stored.
model OtpCode {
  id          String     @id @default(cuid())
  /// Phone (E.164) or lower-cased email the code was sent to.
  target      String
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  userId      String?    @map("user_id")
  ipAddress   String?    @map("ip_address")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

/// Linked social logins (Google, Apple).
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// SOP §6.3: travellers kept on the profile and offered on every checkout form.
model SavedTraveller {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String?
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Saving the same person again updates them.
  @@unique([userId, firstName, lastName])
  @@index([userId, updatedAt])
  @@map("saved_travellers")
}

model Address {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  label      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String    @map("postal_code")
  /// ISO 3166-1 alpha-2
  country    String    @default("IN") @db.Char(2)
  latitude   Float?
  longitude  Float?
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ────────────────────────────── Platform ─────────────────────────────

/// Append-only record of security-relevant and administrative actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Runtime-configurable settings managed from the admin panel.
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// ────────────────────────────── Flights ──────────────────────────────

// ────────────────────────────── Bookings ─────────────────────────────

model Booking {
  id                  String        @id @default(cuid())
  /// Customer-facing unguessable reference: ZB/ZF/ZH + 10 base32 characters
  reference           String        @unique
  userId              String        @map("user_id")
  serviceType         ServiceType   @map("service_type")
  status              BookingStatus @default(DRAFT)
  paymentStatus       PaymentStatus @default(CREATED) @map("payment_status")
  currency            String        @default("INR") @db.Char(3)
  baseAmountPaise     Int           @map("base_amount_paise")
  taxAmountPaise      Int           @map("tax_amount_paise")
  feeAmountPaise      Int           @default(0) @map("fee_amount_paise")
  discountAmountPaise Int           @default(0) @map("discount_amount_paise")
  /// Applied coupon (discount is recomputed server-side on apply/remove).
  couponId            String?       @map("coupon_id")
  totalAmountPaise    Int           @map("total_amount_paise")
  contactEmail        String        @map("contact_email")
  contactPhone        String        @map("contact_phone")
  travelDate          DateTime      @map("travel_date") @db.Date
  /// Seats/rooms are held until this time; unpaid bookings are then cancelled.
  holdExpiresAt       DateTime?     @map("hold_expires_at")
  confirmedAt         DateTime?     @map("confirmed_at")
  cancelledAt         DateTime?     @map("cancelled_at")
  cancellationReason  String?       @map("cancellation_reason")
  /// Refund owed after a customer cancellation (paise), from the supplier's policy.
  refundAmountPaise   Int?          @map("refund_amount_paise")
  /// Client-supplied Idempotency-Key; retries of the same request return the same booking.
  idempotencyKey      String?       @map("idempotency_key")
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id])
  coupon      Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption  CouponRedemption?
  passengers  BookingPassenger[]
  flights     FlightBooking[]
  bus         BusBooking?
  busSeats    BusSeatHold[]
  flightSeats FlightSeatHold[]
  hotel       HotelBookingDetail?
  hotelRooms  HotelBookingRoom[]
  hotelHolds  HotelRoomHold[]
  payments    Payment[]
  events      BookingEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([serviceType, travelDate])
  @@map("bookings")
}

/// Append-only audit of every status change of a booking.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String         @map("booking_id")
  /// Null for the creating event.
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  /// `user:<id>`, `system`, `job:release-holds`, `webhook:<provider>`
  actor      String
  reason     String?
  at         DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
  @@map("booking_events")
}

model BookingPassenger {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  sequence          Int
  type              PassengerType
  title             String
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  /// Age in years on the travel date (buses ask for age rather than date of birth).
  age               Int?
  gender            Gender
  /// Bus/train seat assigned to this traveller.
  seatNumber        String?       @map("seat_number")
  /// Infants: sequence of the adult they travel with.
  travellingWith    Int?          @map("travelling_with")
  /// Passport (international flights): AES-256-GCM ciphertext, never plaintext.
  passportNumberEnc String?       @map("passport_number_enc")
  passportExpiryEnc String?       @map("passport_expiry_enc")
  nationality       String?       @db.Char(2)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tickets FlightTicket[]

  @@unique([bookingId, sequence])
  @@map("booking_passengers")
}

/// One direction of a flight booking (outbound = 1, return = 2), with the offer and fare as sold.
model FlightBooking {
  id              String     @id @default(cuid())
  bookingId       String     @map("booking_id")
  sequence        Int
  provider        String
  offerId         String     @map("offer_id")
  /// Itinerary the seats are held on (mock provider)
  itineraryKey    String     @map("itinerary_key")
  fareId          String     @map("fare_id")
  fareFamily      String     @map("fare_family")
  cabin           CabinClass
  seats           Int
  originCode      String     @map("origin_code")
  destinationCode String     @map("destination_code")
  departureAt     DateTime   @map("departure_at")
  arrivalAt       DateTime   @map("arrival_at")
  /// Offer as sold: carrier, slices (segments, layovers), seats left.
  offer           Json
  /// Fare family as sold: per-passenger fares, baggage, fees.
  fare            Json
  /// Airline booking reference (PNR), set on confirmation.
  pnr             String?
  /// The airline's own record locator, when it differs from the PNR.
  airlineLocator  String?    @map("airline_locator")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tickets FlightTicket[]

  @@unique([bookingId, sequence])
  @@map("flight_bookings")
}

/// One e-ticket: per traveller and direction.
model FlightTicket {
  id              String @id @default(cuid())
  flightBookingId String @map("flight_booking_id")
  passengerId     String @map("passenger_id")
  ticketNumber    String @unique @map("ticket_number")
  /// The direction it covers, e.g. "PNQ-DEL"
  segmentKey      String @map("segment_key")

  flightBooking FlightBooking    @relation(fields: [flightBookingId], references: [id], onDelete: Cascade)
  passenger     BookingPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([flightBookingId, passengerId])
  @@map("flight_tickets")
}

/// Seats held or sold through ZPROO GO on a mock itinerary. Counted against the airline's seats
/// under a per-itinerary advisory lock; released holds set `active` to NULL.
model FlightSeatHold {
  id           String    @id @default(cuid())
  itineraryKey String    @map("itinerary_key")
  bookingId    String    @map("booking_id")
  seats        Int
  /// Unpaid holds lapse at this time; null once paid.
  expiresAt    DateTime? @map("expires_at")
  active       Boolean?  @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([itineraryKey, active])
  @@map("flight_seat_holds")
}

// ────────────────────────────── Buses ─────────────────────────────

/// The bus journey of a booking, with a snapshot of the trip as sold.
model BusBooking {
  id              String   @id @default(cuid())
  bookingId       String   @unique @map("booking_id")
  provider        String
  tripId          String   @map("trip_id")
  operatorName    String   @map("operator_name")
  /// e.g. "A/C Sleeper (2+1)"
  busType         String   @map("bus_type")
  /// City codes, e.g. PNQ → BOM
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  departureAt     DateTime @map("departure_at")
  arrivalAt       DateTime @map("arrival_at")
  seats           String[]
  /// { id, name, landmark, address, time } chosen by the customer
  boardingPoint   Json     @map("boarding_point")
  droppingPoint   Json     @map("dropping_point")
  /// Trip as sold: operator, coach, amenities, policies.
  offer           Json
  /// Operator's ticket/PNR number, set on confirmation.
  pnr             String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("bus_bookings")
}

/// A seat held or sold on a trip. `active` is true while the hold or sale stands and NULL once
/// released; PostgreSQL treats NULLs as distinct, so the unique (trip, seat, active) constraint
/// allows any number of released rows but only one live hold per seat.
model BusSeatHold {
  id        String    @id @default(cuid())
  tripId    String    @map("trip_id")
  seatNo    String    @map("seat_no")
  bookingId String    @map("booking_id")
  /// Held for a woman (the seat beside it becomes ladies-only)
  female    Boolean   @default(false)
  /// Unpaid holds lapse at this time; null once paid.
  expiresAt DateTime? @map("expires_at")
  active    Boolean?  @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNo, active])
  @@index([bookingId])
  @@map("bus_seat_holds")
}

// ────────────────────────────── Payments ─────────────────────────────

model HotelBookingDetail {
  id              String   @id @default(cuid())
  bookingId       String   @unique @map("booking_id")
  provider        String
  hotelId         String   @map("hotel_id")
  hotelName       String   @map("hotel_name")
  address         String
  /// IST calendar dates; nights = checkOut − checkIn in days
  checkIn         DateTime @map("check_in") @db.Date
  checkOut        DateTime @map("check_out") @db.Date
  nights          Int
  /// Hotel's confirmation number and the supplier's reference, set on confirmation.
  confirmationNo  String?  @map("confirmation_no")
  supplierRef     String?  @map("supplier_ref")
  /// Plain text (markup and control characters removed before storing).
  specialRequests String?  @map("special_requests")
  /// Property as sold: name, stars, phone, times, images, house rules.
  hotel           Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_booking_details")
}

model HotelBookingRoom {
  id                    String    @id @default(cuid())
  bookingId             String    @map("booking_id")
  sequence              Int
  roomTypeId            String    @map("room_type_id")
  roomName              String    @map("room_name")
  rateId                String    @map("rate_id")
  boardBasis            String    @map("board_basis")
  refundable            Boolean
  freeCancellationUntil DateTime? @map("free_cancellation_until")
  adults                Int
  childAges             Int[]     @map("child_ages")
  /// { title, firstName, lastName }
  leadGuest             Json      @map("lead_guest")
  /// Whole stay for this room, before taxes (paise)
  price                 Int
  taxes                 Int
  /// [{ date, price }] per night (paise)
  nightly               Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, sequence])
  @@map("hotel_booking_rooms")
}

/// Rooms held or sold through ZPROO GO on generated (mock) properties, per room type and stay.
model HotelRoomHold {
  id         String    @id @default(cuid())
  hotelId    String    @map("hotel_id")
  roomTypeId String    @map("room_type_id")
  bookingId  String    @map("booking_id")
  checkIn    DateTime  @map("check_in") @db.Date
  checkOut   DateTime  @map("check_out") @db.Date
  rooms      Int
  /// Unpaid holds lapse at this time; null once paid.
  expiresAt  DateTime? @map("expires_at")
  active     Boolean?  @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([hotelId, active])
  @@index([bookingId])
  @@map("hotel_room_holds")
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  userId            String        @map("user_id")
  provider          String
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(CREATED)
  method            String?
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

/// Gateway webhook events already processed (dedupe by the provider's event ID).
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String   @unique @map("event_id")
  type       String
  /// Our payment the event was about, if any.
  paymentId  String?  @map("payment_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("webhook_events")
}

// ────────────────────────────── Platform: idempotency ─────────────────────────────

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

/// Stored responses for retried POSTs (Idempotency-Key). Same key + same body replays the
/// response; same key + different body is IDEMPOTENCY_CONFLICT. Kept 24 hours.
model IdempotencyKey {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  /// `METHOD /path` of the route, so one key can't be replayed against another endpoint.
  scope          String
  key            String
  /// SHA-256 of the canonical JSON body.
  requestHash    String           @map("request_hash")
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at")
  expiresAt      DateTime         @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ────────────────────────────── Coupons ─────────────────────────────

enum DiscountType {
  FLAT
  PERCENT
}

model Coupon {
  id               String       @id @default(cuid())
  /// Upper-case code customers type, e.g. ZPROOFIRST
  code             String       @unique
  description      String
  /// Null = every bookable service.
  serviceType      ServiceType? @map("service_type")
  discountType     DiscountType @map("discount_type")
  /// FLAT: paise. PERCENT: basis points (1000 = 10%).
  value            Int
  /// Upper bound of the discount in paise (PERCENT coupons).
  maxDiscountPaise Int?         @map("max_discount_paise")
  /// Booking subtotal (before discount) must be at least this.
  minAmountPaise   Int          @default(0) @map("min_amount_paise")
  startsAt         DateTime     @map("starts_at")
  endsAt           DateTime     @map("ends_at")
  /// Uses per customer (live holds and confirmed bookings count).
  perUserLimit     Int          @default(1) @map("per_user_limit")
  /// Uses across all customers; null = unlimited.
  totalLimit       Int?         @map("total_limit")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  bookings    Booking[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

/// A coupon applied to a booking. Counts towards limits while the booking is held or confirmed.
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String   @map("coupon_id")
  userId        String   @map("user_id")
  bookingId     String   @unique @map("booking_id")
  discountPaise Int      @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}
